# Spring Boot reads these as system env vars. Set them in your shell or your IDE run config.

# --- NeonDB (PostgreSQL) ---
DB_URL=jdbc:postgresql://YOUR-HOST/neondb?sslmode=require
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# --- JWT (HS256) ---
# Must be at least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
JWT_ISSUER=drishti
JWT_ACCESS_TTL=86400
JWT_VERIFY_TTL=86400
JWT_RESET_TTL=3600

# Dev escape hatch: set to false to log in without confirming the verification email.
REQUIRE_EMAIL_VERIFIED=true

# --- Google Sign-In ---
# OAuth 2.0 "Web application" client ID from https://console.cloud.google.com
# (APIs & Services > Credentials). Add http://localhost:3000 as an authorized
# JavaScript origin. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=

# --- Phone OTP ---
# true = OTP is returned in the API response (so the UI can show it in dev).
# Set false to only log it to the backend console.
PHONE_DEV_RETURN_OTP=true
# Admin (role=ADMIN) accounts always verify their phone with this fixed OTP.
PHONE_ADMIN_OTP=000000
# Real SMS for non-admin users via Fast2SMS (https://www.fast2sms.com).
# Blank = console dev-mock. Note: Indian SMS delivery requires DLT registration.
FAST2SMS_API_KEY=

# --- SMTP (email verification + password reset) ---
# Optional in dev. If MAIL_USERNAME is empty, emails just won't be sent
# (set REQUIRE_EMAIL_VERIFIED=false above so users can still log in).
# For Gmail use an app password, not your account password.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-mailbox@example.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=your-mailbox@example.com

# --- App URLs ---
FRONTEND_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000
CHAT_API_URL=http://localhost:8000/api/chat
