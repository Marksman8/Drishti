# Copy to .env.local and fill in
REACT_APP_API_URL=http://localhost:8080

# Python AI service (used directly by the chat assistant)
REACT_APP_AI_URL=http://localhost:8000

# Google Sign-In: OAuth 2.0 Web client ID from Google Cloud Console.
# Must match GOOGLE_CLIENT_ID in the backend .env. Leave blank to hide the button.
REACT_APP_GOOGLE_CLIENT_ID=
